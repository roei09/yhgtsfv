# Security & caching headers — read by Cloudflare Pages and Netlify (other hosts: set the same headers in the server config).
# The CSP here mirrors the <meta> tag in index.html, plus frame-ancestors, which only works as a real HTTP header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/lenis@1.1.13/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://images.kick.com https://*.kick.com; connect-src 'self' https://kick.com https://links.odedlink26.workers.dev; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), microphone=(self)

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# CSS/JS are referenced with ?v=… — bump the version in index.html whenever a file changes
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=604800
